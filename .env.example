# Generate a long random value; never commit the real operator token.
GUARD_ADMIN_TOKEN=replace-with-at-least-32-random-characters
GUARD_API_TOKEN_SECRET=use-a-different-32-character-signing-secret
GUARD_GUEST_REQUEST_LIMIT=10
GUARD_SEMANTIC_JUDGE_ENABLED=auto
GUARD_JUDGE_MODEL=
GUARD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Browser-safe Supabase project settings used for Google and anonymous auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
