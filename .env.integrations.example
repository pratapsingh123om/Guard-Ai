# Guard-AI operator access. Generate at least 32 random characters.
GUARD_ADMIN_TOKEN=

# OpenRouter / OpenAI-compatible provider.
OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_NAME=Guard-AI

# Supabase REST access. Prefer an anon key with Row Level Security enabled.
SUPABASE_URL=replace-me
SUPABASE_ANON_KEY=replace-me

# Optional direct PostgreSQL access. Use a dedicated read-only database role.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=guard_ai_reader
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=verify-full

# Local SQLite demonstration.
GUARD_SQLITE_ROOT=demo/integration-data
