{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "app.py" },
    { "src": "/chat", "dest": "app.py" },
    { "src": "/health", "dest": "app.py" },
    { "src": "/mcp(.*)", "dest": "app.py" },
    { "src": "/docs", "dest": "app.py" },
    { "src": "/openapi.json", "dest": "app.py" },
    { "src": "/assets/(.*)", "dest": "frontend/assets/$1" },
    { "src": "/", "dest": "frontend/index.html" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
